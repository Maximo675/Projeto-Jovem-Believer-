# ─────────────────────────────────────────────────────────────────────────
# Variáveis do ambiente Docker local. Copie este arquivo para ".env.docker"
# (esse nome já está no .gitignore) e ajuste se precisar.
#
#   cp .env.docker.example .env.docker
# ─────────────────────────────────────────────────────────────────────────

# FLASK_ENV=production faz o app usar o Postgres (serviço "db" do compose)
# em vez do SQLite — é isso que dá paridade com o ambiente do Render.
FLASK_ENV=production
FLASK_PORT=5001

# Banco (aponta pro serviço "db" do docker-compose.yml, não "localhost")
DB_HOST=db
DB_PORT=5432
DB_USER=wingedmind
DB_PASSWORD=wingedmind_local_dev
DB_NAME=wingedmind_db
# O Postgres do Render exige SSL; o Postgres local do Docker não tem
# certificado configurado, então desligamos a exigência aqui.
DB_SSLMODE=disable

SECRET_KEY=docker-local-dev-secret-troque-se-quiser
JWT_SECRET=docker-local-dev-jwt-secret-troque-se-quiser
JWT_EXPIRATION=86400

# IA em modo mock por padrão — sem custo e sem risco de crash no boot.
# Pra testar a IA real (OpenAI) aqui é seguro, porque localmente o app
# roda com "python run.py" (modo threading), não com o worker eventlet
# do gunicorn que causava o crash em produção. Pra ligar:
#   USE_MOCK_AI=false
#   OPENAI_API_KEY=sua-chave-real-aqui
USE_MOCK_AI=true
USE_OLLAMA=false
OPENAI_API_KEY=dummy-not-used-mock-mode
OPENAI_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001
APP_BASE_URL=http://localhost:5001
